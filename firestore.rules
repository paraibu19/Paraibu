rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAnalyticsEvent(data) {
      let allowedKeys = ['type', 'timestamp', 'language', 'medications', 'weight', 'patientName'];
      return data.keys().hasAll(['type', 'timestamp']) &&
             data.keys().size() <= 6 &&
             data.type in ['CALCULATION', 'PDF_DOWNLOAD', 'CALENDAR_EXPORT'] &&
             data.timestamp is timestamp;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Analytics events
    match /analytics_events/{eventId} {
      allow create: if isValidAnalyticsEvent(request.resource.data);
      allow read: if true; // Publicly readable for the anonymous dashboard
      allow update, delete: if false; 
    }
  }
}
